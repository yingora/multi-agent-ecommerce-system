# Local development: default mode makes no provider requests.
ECOM_LLM_MODE=offline
# Live mode is an explicit opt-in and may incur charges. Keep the key private.
ECOM_LLM_API_KEY=
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1
ECOM_AB_TEST_ENABLED=true
ECOM_AB_TEST_DEFAULT_BUCKET_COUNT=100
# Stored for future integrations; no storage client is wired to the serving path.
ECOM_REDIS_URL=redis://localhost:6379/0
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530
ECOM_DATABASE_URL=sqlite:///./ecommerce.db
